<Window x:Class="UD03_TaskFlowDAM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TaskFlow DAM"
        Height="680"
        Width="850"
        MinHeight="500"
        MinWidth="650"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#3A1313">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera fija -->
        <Border Grid.Row="0"
                Padding="20"
                Background="#3A1313">

            <StackPanel>
                <TextBlock Text="TaskFlow DAM"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#FFF7F2"/>

                <TextBlock Text="Organiza tus tareas. Controla tu progreso."
                           FontSize="13"
                           Foreground="#FFA4A4"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Contenido principal con scroll general -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="15">

                <!-- Tarjeta: nueva tarea -->
                <Border Background="#FFF7F2"
                        CornerRadius="12"
                        Padding="18"
                        Margin="0,0,0,15">

                    <StackPanel>
                        <TextBlock Text="Nueva tarea"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#2A1111"
                                   Margin="0,0,0,15"/>

                        <Label Content="_Título de la tarea:"
                               Target="{Binding ElementName=TxtTitulo}"
                               Foreground="#2A1111"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>

                        <TextBox x:Name="TxtTitulo"
                                 Text="{Binding NuevoTitulo, UpdateSourceTrigger=PropertyChanged}"
                                 Height="36"
                                 Padding="8"
                                 Margin="0,0,0,12"
                                 TabIndex="1"
                                 AutomationProperties.Name="Título de la tarea"
                                 AutomationProperties.HelpText="Introduzca el título de la tarea"/>

                        <!-- Módulo y fecha límite -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Label Content="_Módulo formativo"
                                       Target="{Binding ElementName=CmbModulo}"
                                       Foreground="#2A1111"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>



                                <ComboBox x:Name="CmbModulo"
                                          SelectedValue="{Binding NuevoModulo}"
                                          SelectedValuePath="Content"
                                          Height="36"
                                          TabIndex="2"
                                          AutomationProperties.Name="Selector de módulo"
                                          AutomationProperties.HelpText="Selecciona el módulo al que pertenece">
                                    <ComboBoxItem Content="DI"/>
                                    <ComboBoxItem Content="SGE"/>
                                    <ComboBoxItem Content="AD"/>
                                    <ComboBoxItem Content="PSP"/>
                                    <ComboBoxItem Content="PMDM"/>
                                    <ComboBoxItem Content="EIE"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Label Content="_Fecha límite:"
                                       Target="{Binding ElementName=FechaLimitePicker}"
                                       Foreground="#2A1111"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>

                                <DatePicker x:Name="FechaLimitePicker"
                                            SelectedDate="{Binding NuevaFechaLimite}"
                                            Height="36"
                                            TabIndex="3"
                                            AutomationProperties.Name="Fecha límite de la tarea"
                                            AutomationProperties.HelpText="Selecciona la fecha prevista"/>
                            </StackPanel>
                        </Grid>

                        <!-- Prioridad -->
                        <Label Content="_Prioridad"
                               Target="{Binding ElementName=CmbPrioridad}"
                               Foreground="#2A1111"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>

                        <ComboBox x:Name="CmbPrioridad"
                                  SelectedValue="{Binding NuevaPrioridad}"
                                  SelectedValuePath="Content"
                                  Height="36"
                                  Margin="0,0,0,12"
                                  TabIndex="4"
                                  AutomationProperties.Name="Selector de prioridad"
                                  AutomationProperties.HelpText="Selecciona la prioridad de la tarea">
                            <ComboBoxItem Content="Alta"/>
                            <ComboBoxItem Content="Media"/>
                            <ComboBoxItem Content="Baja"/>
                        </ComboBox>

                        <!-- Urgencia -->
                        <CheckBox x:Name="ChkUrgente"
                                  Content="_Es urgente"
                                  IsChecked="{Binding NuevaEsUrgente}"
                                  Foreground="#2A1111"
                                  Margin="0,0,0,15"
                                  TabIndex="5"
                                  AutomationProperties.Name="Marcar tarea como urgente"
                                  AutomationProperties.HelpText="Marca la tarea como urgente"/>

                        <!-- Botones del formulario -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">

                            <Button x:Name="BtnLimpiar"
                                    Content="Limpiar"
                                    Click="BtnLimpiar_Click"
                                    IsCancel="True"
                                    Padding="18"
                                    Margin="0,0,10,0"
                                    MinHeight="36"
                                    TabIndex="6"
                                    AutomationProperties.Name="Limpiar formulario"
                                    AutomationProperties.HelpText="Limpia todos los campos del formulario"/>

                            <Button x:Name="BtnAgregar"
                                    Content="Añadir tarea"
                                    Click="BtnAgregar_Click"
                                    IsEnabled="{Binding PuedeAgregar}"
                                    IsDefault="true"
                                    Padding="18,9"
                                    MinHeight="36"
                                    FontWeight="SemiBold"
                                    TabIndex="7"
                                    AutomationProperties.Name="Añadir tarea"
                                    AutomationProperties.HelpText="Añade una nueva tarea"
                                    ToolTip="Introduce un título para registrar la tarea"
                                    ToolTipService.ShowOnDisabled="True">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}">
                                        <Setter Property="Background" Value="#A6324B"/>
                                        <Setter Property="Foreground" Value="#FFF7F2"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#E8D8D2"/>
                                                <Setter Property="Foreground" Value="#2A1111"/>
                                            </Trigger>
                                        </Style.Triggers>

                                    </Style>
                                </Button.Style>
                                
                             </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Tarjeta: progreso -->
                <Border Background="#FFF7F2"
                        CornerRadius="12"
                        Padding="15"
                        Margin="0,0,0,15">

                    <StackPanel>
                        <TextBlock Text="Tu progreso"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#2A1111"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="{Binding TextoProgreso}"
                                   Foreground="#7A5C5C"
                                   Margin="0,0,0,10"/>

                        <ProgressBar Value="{Binding PorcentajeProgreso, Mode=OneWay}"
                                     Minimum="0"
                                     Maximum="100"
                                     Height="14"
                                     Background="#E8D8D2"
                                     Foreground="#A6324B"/>
                    </StackPanel>
                </Border>

                <!-- Tarjeta: lista de tareas -->
                <Border Background="#FFF7F2"
                        CornerRadius="12"
                        Padding="18">

                    <StackPanel>
                        <TextBlock Text="Mis tareas"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#2A1111"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="{Binding TareasPendientesCount, StringFormat='Tareas pendientes: {0}'}"
                                   Foreground="#7A5C5C"/>

                        <ListBox ItemsSource="{Binding Tareas}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Margin="0,12,0,0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 PreviewMouseWheel="ListaTareas_PreviewMouseWheel">


                            <ListBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ListBoxItem}">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            
                            
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFF7F2"
                                            BorderBrush="#733232"
                                            BorderThickness="0,0,0,1"
                                            Padding="8">

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding Completada, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,0"
                                                      AutomationProperties.Name="Tarea completada"
                                                      AutomationProperties.HelpText="Marca esta casilla para indicar que la tarea está completada"/>

                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center">

                                                <TextBlock Text="{Binding Titulo}"
                                                           FontWeight="SemiBold"
                                                           FontSize="14"
                                                           Foreground="#2A1111"
                                                           TextWrapping="Wrap"/>

                                                <TextBlock Text="{Binding Modulo}"
                                                           FontSize="12"
                                                           Foreground="#7A5C5C"
                                                           Margin="0,8,0,0"/>

                                                <TextBlock Text="{Binding FechaLimiteFormateada}"
                                                           FontSize="12"
                                                           Foreground="#7A5C5C"
                                                           Margin="0,8,0,0"/>

                                                <TextBlock Text="{Binding Prioridad}"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="#A6324B"
                                                           Margin="0,8,0,0"/>
                                            </StackPanel>

                                            <Button Grid.Column="2"
                                                    Content="Eliminar"
                                                    Click="BtnEliminar_Click"
                                                    Padding="8"
                                                    Margin="10,0,0,0"
                                                    MinHeight="36"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="Eliminar tarea"
                                                    AutomationProperties.HelpText="Elimina la tarea seleccionada"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Barra inferior fija -->
        <Border Grid.Row="2"
                Padding="12"
                Background="#2A1111">

            <TextBlock Text="{Binding EstadoApp}"
                       Foreground="#FFA4A4"
                       FontSize="12"/>
        </Border>
    </Grid>
</Window>
